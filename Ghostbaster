    -- Fast Throw Counter Hook
    local monitoredProps = {}
    local function hookPropListener(prop)
        if not prop:IsA("BasePart") or monitoredProps[prop] then return end
        monitoredProps[prop] = true

        local lastPos = prop.Position
        prop:GetPropertyChangedSignal("Position"):Connect(function()
            pcall(function()
                local curPos = prop.Position
                local delta = (curPos - lastPos).Magnitude
                if delta > 1.8 and prop.AssemblyLinearVelocity.Magnitude > 3.0 and isInsideHouse(curPos) then
                    totalThrowsCount = totalThrowsCount + 1
                    local throwTxt = "Throws detected: " .. tostring(totalThrowsCount)
                    ThrowCounterCard.Text = throwTxt
                    if liveFloatingThrowLabel then
                        liveFloatingThrowLabel.Text = throwTxt
                    end
                end
                lastPos = curPos
            end)
        end)
    end

    local itemsFolder = Workspace:FindFirstChild("Items")
    if itemsFolder then
        for _, itm in pairs(itemsFolder:GetDescendants()) do
            if itm:IsA("BasePart") then hookPropListener(itm) end
        end
        itemsFolder.DescendantAdded:Connect(function(itm)
            if itm:IsA("BasePart") then hookPropListener(itm) end
        end)
