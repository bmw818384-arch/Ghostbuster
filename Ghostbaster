            page.Visible = true
            btn.BackgroundColor3 = Color3.fromRGB(43, 51, 77)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            bStroke.Color = Color3.fromRGB(66, 133, 244)
            currentTab = tabName
        end)

        tabs[tabName] = { btn = btn, page = page, stroke = bStroke }
        if currentTab == nil then
            page.Visible = true
            btn.BackgroundColor3 = Color3.fromRGB(43, 51, 77)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            bStroke.Color = Color3.fromRGB(66, 133, 244)
