    local function getToolCategory(model)
        if not model or not (model:IsA("Model") or model:IsA("Folder")) then return nil end
        local prompt = model:FindFirstChildOfClass("ProximityPrompt")
        local objText = prompt and string.lower(prompt.ObjectText or "") or ""

        if string.find(objText, "laser") then return "Laser Projector" end
        if string.find(objText, "spirit book") or string.find(objText, "book") then return "Spirit Book" end
        if string.find(objText, "spirit box") or string.find(objText, "box") then return "Spirit Box" end
        if string.find(objText, "emf") or string.find(objText, "volt") or string.find(objText, "gauge") then return "EMF Reader" end
        if string.find(objText, "flower") then return "Flower Pot" end
        if string.find(objText, "thermo") then return "Thermometer" end
        if string.find(objText, "uv") or string.find(objText, "blacklight") then return "Blacklight" end
        if string.find(objText, "camera") or string.find(objText, "video") then return "Video Camera" end
        if string.find(objText, "flashlight") then return "Flashlight" end

        local mName = string.lower(model.Name)
        if string.find(mName, "voltgauge") or string.find(mName, "emf") then return "EMF Reader" end
        if string.find(mName, "spiritbox") then return "Spirit Box" end
        if string.find(mName, "flower") then return "Flower Pot" end
        if string.find(mName, "book") then return "Spirit Book" end
        if string.find(mName, "projector") or string.find(mName, "laser") then return "Laser Projector" end
        if string.find(mName, "thermo") then return "Thermometer" end

        if model:FindFirstChild("Indicators", true) then return "EMF Reader" end
        if model:FindFirstChild("GhostTalk", true) or model:FindFirstChild("PlayerTalk", true) then return "Spirit Box" end
        if model:FindFirstChild("LeftPage", true) or model:FindFirstChild("RightPage", true) then return "Spirit Book" end
        if model:FindFirstChild("OptimizedFlower", true) then return "Flower Pot" end
        if model:FindFirstChild("Light", true) and model:FindFirstChild("Base", true) then return "Laser Projector" end
        if model:FindFirstChild("Screen", true) then return "Thermometer" end

        return prompt and prompt.ObjectText or "Tool"
    end

