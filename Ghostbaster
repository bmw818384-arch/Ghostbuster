                    local mapFolder = Workspace:FindFirstChild("Map")
                    if mapFolder then
                        for _, obj in pairs(mapFolder:GetDescendants()) do
                            local lName = string.lower(obj.Name)
                            if (lName == "ghostorb" or lName == "orb" or lName == "ghost_orb") and isInsideHouse(obj:IsA("BasePart") and obj.Position or obj:GetPivot().Position) then
