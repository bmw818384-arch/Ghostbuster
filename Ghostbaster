    task.spawn(function()
        local lastGhostPos = nil
        local lastCheckTick = os.clock()
        local entityGhostSnaps = 0
        local vexClipTicks = 0

        -- Phantom Tracker
        local invisibleTimer = 0
        local lastVisibilityState = true
        local maxSpeedWhileInvisible = 0
        local speedWhileVisible = 0

        -- Revenant Tracker
        local lastHuntEndTick = 0
        local lastPlayerCount = #Players:GetPlayers()

        while ScreenGui and ScreenGui.Parent do
            pcall(function()
                local ghost = getLiveGhost()
                local hrp = ghost and ghost:FindFirstChild("HumanoidRootPart")
                local now = os.clock()
                local dt = now - lastCheckTick

                -- 1. REVENANT TRACKER
                local currentPlayers = 0
                for _, p in pairs(Players:GetPlayers()) do
                    if p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                        currentPlayers = currentPlayers + 1
                    end
                end

                if wasHunting and not isHunting then
                    if currentPlayers < lastPlayerCount then
                        updateGhostIdentity("Revenant", false)
                    end
                    lastHuntEndTick = now
                end

                if isHunting and not wasHunting then
                    local cooldown = now - lastHuntEndTick
                    if lastHuntEndTick > 0 and cooldown <= 18.0 then
                        updateGhostIdentity("Revenant", true)
                    end
                end
                lastPlayerCount = currentPlayers

                if ghost and hrp and isInsideHouse(hrp.Position) then
                    local curPos = hrp.Position
                    local speed = hrp.AssemblyLinearVelocity.Magnitude

                    -- 2. PHANTOM TRACKER (Slow blink + speed burst)
                    if isHunting then
                        local isCurrentlyVisible = false
                        for _, p in pairs(ghost:GetChildren()) do
                            if (p:IsA("BasePart") or p:IsA("MeshPart")) and p.Transparency < 0.75 then
                                isCurrentlyVisible = true
                                break
                            end
                        end

                        if not isCurrentlyVisible then
                            invisibleTimer = invisibleTimer + dt
                            maxSpeedWhileInvisible = math.max(maxSpeedWhileInvisible, speed)
                        else
                            if not lastVisibilityState then
                                speedWhileVisible = speed
                                if invisibleTimer >= 1.1 and (maxSpeedWhileInvisible >= 31.0 or (maxSpeedWhileInvisible - speedWhileVisible >= 6.0)) then
                                    updateGhostIdentity("Phantom", true)
                                elseif invisibleTimer >= 0.9 then
                                    updateGhostIdentity("Phantom", false)
                                end
                                invisibleTimer = 0
                                maxSpeedWhileInvisible = 0
                            end
                        end
                        lastVisibilityState = isCurrentlyVisible
                    else
                        invisibleTimer = 0
                    end

                    -- 3. SIREN TRACKER (Female Only + Hunt Line-of-Sight Player Speed Drop)
                    if isHunting then
                        local gGender = ghost:GetAttribute("Gender")
                        if not gGender or string.lower(tostring(gGender)) == "female" then
                            local myChar = LocalPlayer.Character
                            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                            if myHrp and (myHrp.Position - curPos).Magnitude <= 45.0 then
                                local rayParams = RaycastParams.new()
                                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                                rayParams.FilterDescendantsInstances = {ghost, myChar}
                                local rayResult = Workspace:Raycast(curPos, (myHrp.Position - curPos), rayParams)

                                if not rayResult or not rayResult.Instance then
                                    local mySpeed = myHrp.AssemblyLinearVelocity.Magnitude
                                    -- Player sprint normally 16 studs/s, debuffed to <= 12
                                    if mySpeed > 2.0 and mySpeed <= 12.0 then
                                        updateGhostIdentity("Siren", true)
                                    end
                                end
                            end
                        end
                    end

                    -- 4. RECALIBRATED ONI / WRETCH HUNT SPRINT (Strict 34+ studs/s threshold)
                    if isHunting and speed >= 34.0 then
                        local totalEnergy, pCount = 0, 0
                        for _, p in pairs(Players:GetPlayers()) do
                            local ch = p.Character
                            local en = ch and ch:GetAttribute("Energy")
                            if en then
                                totalEnergy = totalEnergy + en
                                pCount = pCount + 1
                            end
                        end
                        local avgEnergy = (pCount > 0) and (totalEnergy / pCount) or 100

                        if avgEnergy < 50 then
                            updateGhostIdentity("Wretch", true)
                        else
                            updateGhostIdentity("Oni", true)
                        end
                    elseif isHunting and speed >= 31.0 then
                        updateGhostIdentity("Oni", false)
                    end

                    -- 5. ENTITY TELEPORTATION JUMP
                    if lastGhostPos and dt > 0 and dt < 0.35 then
                        local dist = (curPos - lastGhostPos).Magnitude
                        if dist > 18.0 and speed < 8.0 then
                            entityGhostSnaps = entityGhostSnaps + 1
                            if entityGhostSnaps >= 2 then
                                updateGhostIdentity("Entity", true)
                            else
                                updateGhostIdentity("Entity", false)
                            end
                        end
                    end

                    -- 6. VEX WALL NOCLIP CHECK
                    if lastGhostPos and (curPos - lastGhostPos).Magnitude > 3.0 then
                        local moveDir = (curPos - lastGhostPos)
                        local rayParams = RaycastParams.new()
                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                        rayParams.FilterDescendantsInstances = {ghost, LocalPlayer.Character}
                        local rayResult = Workspace:Raycast(lastGhostPos, moveDir, rayParams)

                        if rayResult and rayResult.Instance then
                            local hitPart = rayResult.Instance
                            local hitName = string.lower(hitPart.Name)
                            local isDoor = string.find(hitName, "door") or string.find(hitName, "frame") or string.find(hitName, "entrance")
                            local isRealWall = (string.find(hitName, "wall") or string.find(hitName, "partition")) and (hitPart.Size.Y >= 8 and hitPart.Size.Magnitude > 10)

                            if isRealWall and not isDoor then
                                vexClipTicks = vexClipTicks + 1
                                if vexClipTicks >= 2 then
                                    updateGhostIdentity("Vex", true)
                                else
                                    updateGhostIdentity("Vex", false)
                                end
                            else
                                vexClipTicks = 0
                            end
                        end
                    end

                    lastGhostPos = curPos
                    lastCheckTick = now
                else
                    lastGhostPos = nil
                end
            end)
            task.wait(0.12)
        end
    end)

    local allLightsState = false
    local function isSwitchCurrentlyOn(model)
        local stateAttr = model:GetAttribute("State")
        if stateAttr ~= nil then return stateAttr == true end
        local onPart = model:FindFirstChild("On")
        if onPart and onPart:IsA("BasePart") and onPart.Transparency < 0.5 then return true end
        local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and prompt.ActionText then
            local aText = string.lower(prompt.ActionText)
            if string.find(aText, "off") then return true end
            if string.find(aText, "on") then return false end
        end
        return false
    end

    local function toggleAllLightswitches(btn)
        allLightsState = not allLightsState
        local targetTurnOn = allLightsState
        local count = 0

        pcall(function()
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and (obj.Name == "LightSwitch" or string.find(string.lower(obj.Name), "lightswitch")) then
                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt and fireproximityprompt then
                        local currentlyOn = isSwitchCurrentlyOn(obj)
                        if (targetTurnOn and not currentlyOn) or (not targetTurnOn and currentlyOn) then
                            prompt.RequiresLineOfSight = false
                            fireproximityprompt(prompt)
                            count = count + 1
                        end
                    end
                end
            end
        end)

        if btn then
            btn.Text = targetTurnOn and "Turn OFF" or "Turn ON"
            btn.BackgroundColor3 = targetTurnOn and Color3.fromRGB(40, 140, 70) or Color3.fromRGB(43, 62, 115)
        end
