    local function smartTurnOnFuseBox()
        pcall(function()
            local fBox = Workspace:FindFirstChild("FuseBox", true)
            if not fBox then
                notify("Fuse Box", "Fuse box not located", 3)
                return
            end

            local door = fBox:FindFirstChild("Door", true)
            local doorPrompt = door and (door:FindFirstChildOfClass("ProximityPrompt") or door:FindFirstChild("ItemPrompt", true))
            
            if doorPrompt and fireproximityprompt then
                fireproximityprompt(doorPrompt)
                task.wait(0.35)
            end

            for _, p in pairs(fBox:GetDescendants()) do
                if p:IsA("ProximityPrompt") and p ~= doorPrompt then
                    fireproximityprompt(p)
                    notify("Fuse Box", "Main power lever engaged", 4)
                    return
                end
            end
            notify("Fuse Box", "Door opened. Switch prompt triggered.", 3)
        end)
    end

