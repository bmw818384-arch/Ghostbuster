    local favRoomBillboard = nil
    local favRoomTextLabel = nil

    task.spawn(function()
        while ScreenGui and ScreenGui.Parent do
            pcall(function()
                local ghost = getLiveGhost()
                local favRoomName = ghost and (ghost:GetAttribute("FavoriteRoom") or ghost:GetAttribute("FavRoom"))

                if favRoomEspActive and favRoomName and tostring(favRoomName) ~= "" and tostring(favRoomName) ~= "nil" then
                    local mapFolder = Workspace:FindFirstChild("Map") or Workspace
                    local target = string.lower(tostring(favRoomName))
                    local targetRoomPart = nil

                    for _, obj in pairs(mapFolder:GetDescendants()) do
                        if obj:IsA("Model") or obj:IsA("Folder") then
                            local mName = string.lower(obj.Name)
                            if mName == target or mName == (target .. "room") or mName == (target .. "zone") then
                                local pivotPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                                if pivotPart and not string.find(string.lower(pivotPart.Name), "door") then
                                    targetRoomPart = pivotPart
                                    break
                                end
                            end
                        end
