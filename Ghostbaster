                                local zName = string.lower(zone.Name)
                                local isNotDecor = not string.find(zName, "door") 
                                    and not string.find(zName, "switch") 
                                    and not string.find(zName, "handle")
                                    and not string.find(zName, "wall")

                                if isNotDecor and (zName == target or zName == (target .. "zone") or zName == "ghosttracker") then
                                    targetRoomPart = zone
                                    break
                                end
                            end
                        end
                    end

                    if targetRoomPart then
