                                local d = (zone.Position - gPos).Magnitude
                                if d < bestDist then
                                    bestDist = d
                                    local parentName = zone.Parent and zone.Parent.Name or ""
                                    if parentName ~= "" and parentName ~= "Map" and parentName ~= "Workspace" and not string.find(string.lower(parentName), "door") then
