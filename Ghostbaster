            local ghost = getLiveGhost()
            if ghost and ghost:FindFirstChild("HumanoidRootPart") then
                local hrp = ghost.HumanoidRootPart
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local dist = myRoot and math.floor((myRoot.Position - hrp.Position).Magnitude) or 0

                local huntDetected = false
                if ghost:GetAttribute("Hunting") == true or ghost:GetAttribute("IsHunting") == true then
                    huntDetected = true
                else
                    for _, snd in pairs(ghost:GetDescendants()) do
                        if snd:IsA("Sound") and snd.IsPlaying then
                            local sName = string.lower(snd.Name)
                            if string.find(sName, "scream") or string.find(sName, "hunt") or string.find(sName, "roar") or string.find(sName, "kill") or string.find(sName, "wail") then
                                huntDetected = true
                                break
                            end
                        end
                    end
                end

                if huntDetected then
                    isHunting = true
                    if not wasHunting then
                        wasHunting = true
                        if huntNotifActive then notify("HUNT STARTED", "Ghost is hunting! Evacuating to camp.", 4) end
                    end
                    if autoEscape and myRoot then
                        local safeCF = getBaseCampCFrame()
                        if safeCF and (myRoot.Position - safeCF.Position).Magnitude > 20 then
                            myRoot.CFrame = safeCF
                        end
                    end
                else
                    isHunting = false
                    if wasHunting then
                        wasHunting = false
                        if huntNotifActive then notify("Safe", "Hunt ended. Ghost returned to roaming.", 3) end
                    end
                end

                if ghostEspActive then
                    ghostHighlight.Enabled = true
                    ghostHighlight.Adornee = ghost
                    ghostHighlight.FillColor = isHunting and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(255, 45, 45)
                    ghostBillboard.Enabled = true
                    ghostBillboard.Adornee = hrp
                    distLbl.Text = (isHunting and "HUNTING [" or "Ghost [") .. tostring(dist) .. "m]"
                    distLbl.TextColor3 = isHunting and Color3.fromRGB(255, 20, 20) or Color3.fromRGB(255, 60, 60)
                else
                    ghostHighlight.Enabled = false
                    ghostBillboard.Enabled = false
                end
            else
                isHunting = false
                ghostHighlight.Enabled = false
                ghostBillboard.Enabled = false
            end
        end)
    end)

