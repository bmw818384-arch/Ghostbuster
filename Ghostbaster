    local function getLiveGhost()
        for _, item in pairs(Workspace:GetChildren()) do
            if item:IsA("Model") and item ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(item) then
                if item:FindFirstChildOfClass("Humanoid") or item:FindFirstChild("HumanoidRootPart") then
                    local lName = string.lower(item.Name)
                    if string.find(lName, "ghost") or string.find(lName, "entity") or item:GetAttribute("GhostType") then
                        return item
                    end
                    for _, m in pairs(GHOST_MODELS) do
                        if string.find(lName, string.lower(m)) then return item end
                    end
                end
            end
        end
        return nil
    end

