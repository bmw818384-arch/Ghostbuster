    -- Smart Lightswitch Controller
    local allLightsState = false

    local function isSwitchCurrentlyOn(model)
        local prompt = model:FindFirstChildOfClass("ProximityPrompt") or model:FindFirstChild("ItemPrompt", true)
        if prompt and prompt.ActionText then
            local aText = string.lower(prompt.ActionText)
            if string.find(aText, "turn off") or string.find(aText, "off") then
                return true
            elseif string.find(aText, "turn on") or string.find(aText, "on") then
                return false
            end
        end

        local onPart = model:FindFirstChild("On", true)
        if onPart and onPart:IsA("BasePart") then
            if onPart.Transparency < 0.5 or onPart.Material == Enum.Material.Neon then
                return true
            end
        end

        return false
    end

    local function toggleAllLightswitches(btn)
        allLightsState = not allLightsState
        local targetTurnOn = allLightsState
        local count = 0

        pcall(function()
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and string.find(string.lower(obj.Name), "lightswitch") then
                    local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChild("ItemPrompt", true)
                    if prompt and fireproximityprompt then
                        local currentlyOn = isSwitchCurrentlyOn(obj)
                        if (targetTurnOn and not currentlyOn) or (not targetTurnOn and currentlyOn) then
                            prompt.RequiresLineOfSight = false
                            fireproximityprompt(prompt)
                            count = count + 1
                        end
                    end
                end
            end
        end)

        if btn then
            btn.Text = targetTurnOn and "Turn OFF" or "Turn ON"
            btn.BackgroundColor3 = targetTurnOn and Color3.fromRGB(40, 140, 70) or Color3.fromRGB(43, 62, 115)
        end

        notify("Lightswitch All", (targetTurnOn and "All lights turned ON (" or "All lights turned OFF (") .. tostring(count) .. " switched)", 3)
    end

